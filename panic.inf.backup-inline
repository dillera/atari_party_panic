!==============================================================================
Object TrainStation "Lobby"
    with
        description "A test room with cheap scenery.",
        cheap_scenery
            'atari' 'ataris//p' "You see Atari computers."
            'window' 'windows//p' "Tall windows.",
    has light;

Object -> framedArticle "framed newspaper article" 
    with
        name 'framed' 'newspaper' 'article' 'paper',
        description "A yellowed newspaper article from 1989.",
    has static;

Object -> articlePlaque "small brass plaque"
    with
        name 'small' 'brass' 'plaque' 'plate',
        description "A small brass plaque beneath the article.",
    has static;

