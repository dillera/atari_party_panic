! --- Bunker (Hidden Underground Facility) ---
Object BunkerRoom "Bunker"
    with
        name 'bunker' 'room' 'military',
        description [;
            print "This hidden bunker is a computing time capsule. Racks of 
                ancient computer equipment line the walls, status lights blinking 
                back on after all these years. The air has a distinct ozone smell 
                mixed with old electronics, dust, and stale oil.^^";
            
            if (power_failed) {
                print "Emergency lighting bathes everything in an eerie blue glow. Most 
                    of the equipment has gone dark, except for the central Atari system 
                    which seems to run on its own power supply.";
            } else {
                print "Fluorescent lights illuminate banks of vintage computer racks, their 
                    cooling fans providing a constant background hum.";
            }
            
            print "^In the center of the room stands a heavy metal table, supporting a 
                heavily modified Atari 800 connected to what appears to be a military-grade 
                telecom system with an an industrial looking modem. 
                A technical notebook rests beside the computer as well as a small diary.^";
            
            rfalse;
        ],
        u_to StorageArea,
        cheap_scenery
            'rack' 'racks//p' "Racks of vintage 1970s and 80s computing equipment."
            'equipment' 'electronics' "Vintage computing equipment from the 1970s and 80s."
            'metal' 'table' "A heavy metal table supporting the Atari system."
            'fan' 'fans//p' "Cooling fans humming quietly in the background.",
    has light;

Object -> logbook "logbook" 
    with 
        name 'logbook' 'technical' 'notebook',
        description "A technical logbook with various entries.",
        before [;
            Examine: 
                print "Technical Logbook - IRON HORSE Facility^^";
                LogbookEntries();
                rtrue;
        ];

Object -> diary "diary"
    with 
        name 'diary' 'personal',
        description "A worn diary filled with personal notes and reflections.",
        before [;
            Examine: 
                print "Personal Diary^^";
                DiaryEntries();
                rtrue;
        ];

Object -> securityModem "modem"
    with
        name  'modem' 'device',
        description "A heavy-duty modem unit labeled ~EMERGENCY COMM LINK - MODEL XFB1~. 
            Various military specification stickers cover its case.",
    has static;

Object -> atari800 "modified Atari 800" 
    with
        name 'atari' '800' 'computer' 'system',
        description [;
            print "This Atari is unlike any you've seen before. Mounted in a 
                military-grade enclosure and bolted on the table
                it's been extensively modified with additional 
                hardware. A government property tag reads: ~IRON HORSE COMM SYSTEM V2.3~.^";
            
            if (pokey_installed)
                "The screen displays: ~EMERGENCY PROTOCOL ACTIVE - ATTEMPTING MODEM SYNC~";
            "The screen shows various error messages about a missing chip to control the modem.";
        ],
        before [;
            Take: "The computer is securely bolted to the table.";
            Receive:
                if (noun == pokeyChip) {
                    if (pokey_installed) {
                        "The POKEY chip is already installed.";
                    }
                    if (power_failed == false) {
                        "You probably shouldn't mess with the computer while everyone's watching.";
                    }
                    if (parent(tools) ~= player) {
                        "You need proper tools to safely handle and install the chip.";
                    }
                    
                    ! Install the chip and trigger victory
                    InstallPokey();
                    score = score + 2;
                    move pokeyChip to chipSlot;
                    
                    print "Very carefully, using the anti-static tools, you install the POKEY chip 
                        into its socket. It fits perfectly with a satisfying click. You power 
                        up the Atari and it boots...^";
                    
                    RestorePower();
                    
                    print "^The Atari's modem immediately springs to life! It dials a long number 
                        and after a familiar squeal of tones you can hear a brief exchange of data
                        via modulated buzzing. The lights on the rack closest to you burst to life 
                        and begin to
                        furiously blink in strange mezmerizing sequences of light and space. 
                        The ancient security system seems to confirm that there is no actual 
                        emergency as bands of red micro lights flicker to green and then get
                        brighter.^^";
        
                    print "With a series of sub-sonic clicks and a loud humming you feel the throb
                         of what must be large motors vibrate behind the nearest wall. You hear 
                         above from the open trap door the  
                         shriek of metal grinding as the heavy shutters retract and then 
                         the main power comes back online with a loud click.^^";
                    
                    score = 50;

                    print "You sit shocked at what just happened, and before you can react another
                            deep rumbling kicks off and a massive metal door that
                            was hidden on the back wall of the bunker slowly swings open. It reveals
                            a very long corridor which slowly illuminates as parallel lines of fluorescent 
                            lighting clack to life in sequence of flashes. The corridor seems way
                            to long to be just be more storage area....^^";

                    print "But wait - you've successfully restored the station's systems and 
                            saved the Atari party! With a heavy heart you turn your back and
                            walk back upstairs, cover the secret bunker entrance with the rug
                            and walk out to try enjoy a game of DigDug with Ben.^^";

                    print "Score: ", score, "/", MAX_SCORE, ". Congratulations!^^^";

                   print "Come back for the next release of Atari Party PANIC in 2026
                            Where you and Ben will return and explore the mysterious corridor
                            in the secret bunker and get to the bottom of all this madness
                            in Quakertown.^^";

                    @quit;

                }
                "That doesn't seem to fit there.";
        ],
    has static container open;

Object -> -> chipSlot "POKEY chip slot"
    with
        name 'slot' 'socket' 'chip',
        description [;
            if (pokey_installed)
                "The POKEY chip is firmly seated in its socket.";
            "An empty IC socket labeled 'POKEY - C012294'. The original chip appears to have been removed.";
        ],
        before [;
            Receive:
                if (noun == pokeyChip) <<Insert noun atari800>>;
                "That doesn't fit in the chip socket.";
        ],
    has static container open;



                                                                                             
