! --- Ticket Office (Swap Meet Area) ---
Object TicketOffice "Ticket Office"
    with
        description [;
            print "The old ticket office has been repurposed into the main swap 
                meet area. Folding tables are laden with Atari computers, parts, books, 
                and random junk. The walls still hold vintage railway timetables.
                There are entire Atari systems here as well as almost every part
                of every Atari ever made. Even things you can't identify.
                A poster hanging up says: ALL SALES FINAL!";
            if (power_failed) {
                print "^^Emergency lighting makes everything look bluish and shadows creep 
                    and shift in the corners.";
            }
            print "^";
        ],
        e_to TrainStation,
        cheap_scenery
            'table' 'tables//p' "Folding tables overflow with Atari equipment and parts."
            'timetable' 'timetables//p' "Yellowed railway schedules from decades past."
            'poster' 'sign' "The poster states: ALL SALES FINAL! in a dot-matrix font.",
    has light;

Object -> atariBox "large cardboard box of Atari parts"
    with
        name 'box' 'cardboard' 'parts',
        description "A large cardboard box containing various Atari computer parts and cables.",
    has container open transparent static;

Object -> -> atariDisk "Atari diagnostic disk"
    with
        name 'disk' 'floppy' 'diagnostic',
        description "A 5.25 inch floppy disk labeled 'Atari Hardware Diagnostics v2.1'.
        A small sticker on the back of the label states FOR ATARI INC INTERNAL USE.
        There are unintelligible scribbles on the label and maybe a date from 1980.",
    has;

Object -> -> pokeyChip "POKEY chip"
    with
        name 'pokey' 'sound' 'chip',
        description [;
            print "Oh an original Atari POKEY - POtentiometer and KEYboard - chip 
            (part number C012294). It handles sound generation, SIO and
            serial I/O operations on the Atari. These are sort of rare now.";
            if (parent(self) == player)
                " You need to be careful handling it - static electricity could damage it
                and these things are super rare.";
            "";
        ],
        after [;
            Take:
                if (self hasnt general) {
                    give self general;
                    score = score + 5;
                    print "You carefully secure the rare chip in your pocket.^";
                }
        ],
    has;

Object -> -> anticChip "ANTIC chip"
    with
        name 'antic' 'gpu' 'chip',
        description [;
            print "An Atari ANTIC - AlphaNumeric Television Interface Controller chip
             (part number C014887). The pride of Jay Miner. It handles 
             video generation and is sort of a primitive GPU for these computers.
             One of the legs on the chip seems to be broken off. ";
            if (parent(self) == player)
                " You need to be careful handling it - static electricity 
                  could damage it further.";
            "";
        ],
        after [;
            Take:
                if (self hasnt general) {
                    give self general;
                    score = score + 5;
                    print "You carefully slide the chip into your pocket, thinking of
                    your favorite podcast and it brings a smile to your face... 
                    Then the chip pricks you. Ouch!^";
                }
        ],
    has;

Object -> tools "electronics toolkit"
    with
        name 'toolkit' 'tools' 'kit',
        description "A small, basic toolkit with small screwdrivers, a chip extraction tool and 
        one of those useles anti-static wrist strap things.",
        after [;
            Take:
                if (self hasnt general) {
                    give self general;
                    score = score + 3;
                    print "You'll need these for any delicate work.^";
                }
        ],
    has;

Object -> drive "Atari 1050 disk drive"
    with
        name '1050' 'diskdrive' 'drive',
        description "The venerable Atari 1050 enhanced density disk drive - did you ever even figure out what
        enhanced density was? The drive looks clean and has a SIO cable stuck in the back of it.
        There is no power supply with it but you don't hear anything when you gently tap it.",
    has static;

Object -> drive2 "Atari 810 disk drive"
    with
        name '810' 'diskdrive' 'drive',
        description "The OG Atari 810 single density disk drive. The beast of a drive is 
        scuffed and well worn. The back top corner has a serious crack in it and there is
        writing on the top in permanent marker. It says DRIVE 3.",
    has static;

Object -> atascii "Atari ATASCII / ASCII Table"
    with
        name 'card' 'paper' 'atascii',
        description "The small stiff paper cardboard lists the ATASCII character codes in decimal,
        hex and the ASCII equivalent. It also shows the graphical representation of the special
        Atari graphics keys. You always wanted one of these and this one is in perfect shape.",
        after [;
            Take:
                if (self hasnt general) {
                    give self general;
                    score = score - 1;
                    print "With a guilty pang you tell yourself this must be the free table 
                    and slide the card into your back pocket.^";
                }
        ],
    has;


                                                                                 
