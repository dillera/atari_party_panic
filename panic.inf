!==============================================================================
! POWER FAILURE DAEMON
!==============================================================================
Object PowerFailureDaemon "power failure daemon"
    with
        daemon [;
            game_turns++;
            
            ! Trigger power failure randomly between turns 3-5
            if (power_failed == false && game_turns >= 3) {
                ! Random chance increases each turn after turn 3
                ! Turn 3: 33% chance, Turn 4: 50% chance, Turn 5: 100% chance
                if (game_turns >= 5 || random(10) <= (game_turns * 2)) {
                    if (location == Platform) {
                        print "^(As the shutters begin to descend, your friend Ben yells and
                        grabs you, pulling you back inside just in time!)^^";
                        PlayerTo(TrainStation);
                    }

                    print "^^[ALERT] Suddenly, a piercing alarm shrieks through the station! ^";
                    print "Red emergency lights begin flashing as heavy metal shutters slam down ";
                    print "over every window and door with a thunderous series of crashes. ^";
                    print "The normal lights flicker and die, replaced by an eerie blue emergency ";
                    print "glow. A computerized voice announces: ~FACILITY LOCKDOWN INITIATED. ";
                    print "EMERGENCY PROTOCOL ACTIVE.~^^";
                    
                    TriggerPowerFailure();
                    
                    print "The cheerful atmosphere of the Atari party has been replaced by ";
                    print "something far more ominous. What kind of train station has a military ";
                    print "emergency lockdown system?^^";
                }
            }
        ],
    has concealed;



                                    
!88  888b      88  88  888888888888  
