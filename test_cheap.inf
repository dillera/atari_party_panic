! Minimal test for cheap_scenery extension

Constant Story "Cheap Scenery Test";
Constant Headline "^A test^";
Constant DEBUG;

Include "lib/globals.h";
Include "lib/puny.h";
Include "lib/ext_cheap_scenery.h";

Object TestRoom "Test Room"
    with
        description "A test room.",
        cheap_scenery
            'test' 'thing' "You see a test thing.",
    has light;

[ Initialise;
    location = TestRoom;
    return 2;
];
